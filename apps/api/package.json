{
  "name": "@macro-chef/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "hono": "^4.6.0",
    "jose": "^5.9.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.22.0",
    "globals": "^16.0.0",
    "prisma": "^6.3.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.5"
  }
}
