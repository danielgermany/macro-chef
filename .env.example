# Copy to .env at repo root or apps/api/.env — Prisma + API read DATABASE_URL and JWT_SECRET

# PostgreSQL (matches docker-compose.yml service)
DATABASE_URL="postgresql://macro_chef:macro_chef@localhost:5432/macro_chef"

# HS256 signing — must be at least 32 characters in production
JWT_SECRET="development-secret-change-me-in-prod-min-32-chars!!"

# API (apps/api)
PORT=3000

# Web (apps/web) — Vite
VITE_API_URL=http://localhost:3000
